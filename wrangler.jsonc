{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duodash",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
